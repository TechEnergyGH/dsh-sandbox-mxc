{
  "name": "dsh-sandbox-mxc",
  "version": "0.2.0-local.5",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "description": "Native Windows MXC/PSEC SandboxProvider for DSH 0.2.2-rc.5; no ACL mutation or unconfined fallback.",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./runner": "./lib/runner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "TEST-RESULTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-error": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-win32-process": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@microsoft/mxc-sdk": "1.0.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "probe": "node lib/runner.js --probe",
    "test:integration": "node scripts/integration.mjs",
    "test:control": "node scripts/control-integration.mjs",
    "pack:plugin": "pnpm pack --pack-destination dist --skip-manifest-obfuscation",
    "pack:source": "python scripts/pack-source.py",
    "verify:release": "python scripts/verify-archives.py"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5"
  }
}
